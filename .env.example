# Copy to .env.local (never commit .env.local). Find both values in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server only (used by api/staff.js). NEVER prefix with VITE_ and never commit it.
# Add it in Vercel -> Settings -> Environment Variables, and in .env.local for `vercel dev`.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
